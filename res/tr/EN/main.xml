		<Res id="exportCSV" tr="Export run (CSV)"/>
		<!-- Toolbar tooltip for the Export CSV button (ToolBar.h, action
		     cMenuAnimation/40). Distinct from "exportCSV" itself, which is used as
		     both the menu item's label and the toolbar button's under-icon label -
		     natGUI's toolbar items take a separate tooltip parameter, same pattern as
		     startTT/stopTT/resetTT/newCitiesTT/compareRunsTT. -->
		<Res id="exportCSVTT" tr="Export the finished run to CSV"/>
		<Res id="exportBusy" tr="Cannot export"/>
		<Res id="exportBusyInfo" tr="Stop the current run before exporting."/>
		<Res id="exportNone" tr="Nothing to export"/>
