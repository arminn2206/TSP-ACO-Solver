		<!-- Renamed from pheromoneModeAll / pheromoneModeThreshold.
		     natGUI's resource store keeps only the first 21 characters of a key, and
		     "pheromoneModeThreshold" is 22 - it survived only because no other key
		     shared its truncated prefix. Both are now well inside the limit. -->
		<Res id="phModeAll" tr="All edges"/>
		<Res id="phModeThreshold" tr="Threshold"/>
		<Res id="reset" tr="Reset"/>
		<Res id="resetTT" tr="Clear current results and start over"/>
		<!-- Renamed from resetWhileRunning / resetWhileRunningInfo (17 and 21 chars).
		     The Info key sat exactly on the 21-character truncation boundary, one
		     character away from colliding with its own prefix - the same failure that
		     forced newCitiesWhileRunning* to become newCitiesBusy*. -->
		<Res id="resetBusy" tr="Cannot reset"/>
		<Res id="resetBusyInfo" tr="Stop the current run before resetting."/>
		<Res id="newCities" tr="New cities"/>
