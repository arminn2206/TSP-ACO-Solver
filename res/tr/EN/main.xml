		<Res id="convIterBest" tr="Iteration best"/>
		<!-- Two-line label tagging the nearest-neighbour reference line at the right
		     edge of the convergence chart (ViewConvergence.h). Was hardcoded English
		     in the source, which was the one place the bilingual UI actually broke:
		     the chart read "Nearest / neighbour 812" while the sidebar row beside it
		     read "Najblizi susjed". Split across two keys because the label is drawn
		     as two stacked lines to fit inside cMarginRight.
		     convNN2 carries the %.0f - the value is appended in the translated
		     string, so a language that puts the number first can do that. -->
		<Res id="convNN1" tr="Nearest"/>
		<Res id="convNN2" tr="neighbour %.0f"/>
		<Res id="closeNOK" tr="Error! Animation is running!"/>
