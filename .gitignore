# Build outputs - regenerated by CMake, never commit
out/
build/

# Visual Studio local state (per-machine, not portable)
.vs/

# CMakeSettings.json caused Release builds to silently produce Debug binaries
# on this project (VS's own CMake integration ignored the dropdown label).
# Left out of the repo on purpose - build with:
#   cmake -S . -B <builddir>
#   cmake --build <builddir> --config Release
# If you decide to keep using it locally, remove this line, but re-verify
# Release actually produces an optimized, non-debug binary before trusting it.
CMakeSettings.json

# CMake cache/generated files if a build dir ever ends up inside the repo
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Compiler/debugger artifacts
*.ilk
*.pdb
*.obj
*.exe
*.dll

# OS cruft
Thumbs.db
.DS_Store
